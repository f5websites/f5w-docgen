    "details": [
      {
        "id": "the-ansible-stats_api-role",
        "title": "The ansible stats_api role",
        "source": "ansible repo, footfall-uvc",
        "blocks": [
          {
            "kind": "paragraph",
            "spans": [
              {
                "kind": "text",
                "text": "Deploy is ansible's job, not this repo's. The role takes the tarball, "
              },
              {
                "kind": "code",
                "text": "docker load"
              },
              {
                "kind": "text",
                "text": "s it on the VPS, templates config from group_vars, and runs the container on the internal proxy network with no published ports."
              }
            ]
          }
        ]
      },
      {
        "id": "registry-free-delivery",
        "title": "Registry-free delivery",
        "blocks": [
          {
            "kind": "paragraph",
            "spans": [
              {
                "kind": "text",
                "text": "No registry to host or authenticate against: the image is saved to a tarball and shipped to the VPS over SSH ("
              },
              {
                "kind": "code",
                "text": "docker save"
              },
              {
                "kind": "text",
                "text": " -\u003e "
              },
              {
                "kind": "code",
                "text": "docker load"
              },
              {
                "kind": "text",
                "text": ")."
              }
            ]
          }
        ]
      },
      {
        "id": "cross-compiling-amd64-on-arm64-carl",
        "title": "Cross-compiling amd64 on arm64 Carl",
        "blocks": [
          {
            "kind": "paragraph",
            "spans": [
              {
                "kind": "text",
                "text": "Carl is arm64; the droplet is amd64. This is fine and needs no second VM:"
              }
            ]
          },
          {
            "kind": "list",
            "items": [
              {
                "spans": [
                  {
                    "kind": "text",
                    "text": "Go cross-compiles natively with CGO disabled - the build stage runs on arm64 at full speed and emits an amd64 binary, no QEMU."
                  }
                ]
              },
              {
                "spans": [
                  {
                    "kind": "text",
                    "text": "Assembling the amd64 image only copies the binary onto the amd64 distroless base - moving layer bytes, never executing amd64 code."
                  }
                ]
              }
            ]
          },
          {
            "kind": "paragraph",
            "spans": [
              {
                "kind": "text",
                "text": "The one thing arm64 cannot do is "
              },
              {
                "kind": "emphasis",
                "text": "run"
              },
              {
                "kind": "text",
                "text": " the amd64 image. You do not need to: the droplet runs it, and "
              },
              {
                "kind": "code",
                "text": "GET /v1/health"
              },
              {
                "kind": "text",
