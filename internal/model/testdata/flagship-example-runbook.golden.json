                "kind": "text",
                "text": " No uncommitted work, so the build is reproducible."
              }
            ]
          },
          {
            "spans": [
              {
                "kind": "strong",
                "text": "A pinned toolchain."
              },
              {
                "kind": "text",
                "text": " The compiler version is fixed, not whatever is on the machine - see "
