    "details": [
      {
        "id": "why-the-build-is-hermetic",
        "title": "Why the build is hermetic",
        "source": "Makefile",
        "blocks": [
          {
            "kind": "paragraph",
            "spans": [
              {
                "kind": "text",
                "text": "A hermetic build pins every input - toolchain, dependencies, build flags - so the same source produces the same artifact on any machine. Without it, \"works on my machine\" becomes a deploy-time surprise."
              }
            ]
          }
        ]
      },
      {
        "id": "how-the-swap-stays-atomic",
        "title": "How the swap stays atomic",
        "source": "scripts/deploy.sh",
        "blocks": [
          {
            "kind": "paragraph",
            "spans": [
              {
                "kind": "text",
                "text": "The new release is staged in full beside the live tree, then a single "
              },
              {
                "kind": "code",
                "text": "rename"
              },
              {
                "kind": "text",
                "text": " replaces the symlink. A rename is atomic on the filesystem, so a concurrent reader sees either the old tree or the new one, never a mixture."
              }
            ]
          }
        ]
      }
    ]
