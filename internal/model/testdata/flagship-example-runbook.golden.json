              {
                "kind": "code",
                "text": "latest"
              },
              {
                "kind": "text",
                "text": "."
              }
            ]
          },
          {
            "title": "Stage the release.",
            "spans": [
              {
                "kind": "text",
                "text": "Copy the built tree into a content-addressed release directory beside the live one, leaving the live tree untouched."
              }
            ]
          },
          {
            "title": "Swap it in.",
            "spans": [
              {
                "kind": "text",
                "text": "Flip the symlink in a single atomic rename, so a reader never observes a half-written tree - see "
